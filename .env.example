# ═══════════════════════════════════════════════════════════
# VNK Automatisation — Environnement
# Copier en .env.local pour le développement local
# ═══════════════════════════════════════════════════════════

# ─── Base de données Postgres (Railway) ────────────────────
DATABASE_URL="postgresql://user:password@host:5432/vnk?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/vnk?schema=public"

# ─── NextAuth v5 ───────────────────────────────────────────
# Générer AUTH_SECRET avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ─── Chiffrement des credentials d intégration (AES-256-GCM) ──
# Master key 32 octets (64 hex). Régénérer avec : openssl rand -hex 32
# Toutes les clés API (Stripe, SendGrid, etc.) saisies dans le portail
# sont chiffrées avec cette clé avant d être stockées en base.
# IMPORTANT : si vous changez cette clé, les credentials existantes deviennent illisibles.
CREDENTIALS_ENCRYPTION_KEY=""

# ─── OAuth Microsoft (Outlook Calendar + Teams meeting auto-gen) ──
# Setup Azure App Registration :
#   1. https://portal.azure.com → Microsoft Entra ID → App registrations → New
#   2. Redirect URI : https://<domain>/api/oauth/microsoft/callback (type Web)
#   3. API permissions (delegated) : offline_access, User.Read, Calendars.ReadWrite, OnlineMeetings.ReadWrite
#   4. Certificates & secrets → New client secret
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/oauth/microsoft/callback"

# ─── OAuth Google (Google Calendar + Meet auto-gen) ──
# Setup Google Cloud Console :
#   1. https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth Client ID
#   2. Application type : Web application
#   3. Authorized redirect URI : https://<domain>/api/oauth/google/callback
#   4. Enable APIs : Google Calendar API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
# AUTH_URL est auto-detecte via trustHost=true dans auth.ts
# Ne PAS le setter sauf si proxy inverse (ex: AUTH_URL="https://mondomaine.ca")
AUTH_TRUST_HOST=true

# ─── SSO (optionnel — configurable aussi via Paramètres) ───
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ─── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ─── Email SMTP (gmail ou autre) ───────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="VNK Automatisation <noreply@vnk.ca>"

# ─── Upload ────────────────────────────────────────────────
MAX_UPLOAD_MB="10"

# ─── Cron (Railway scheduler) ──────────────────────────────
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Utilise par /api/cron/check-invoices, /api/cron/check-contracts, /api/cron/release-scheduled-messages
CRON_SECRET=""

# ─── Email entrant (webhook provider Resend/Postmark/Mailgun) ─
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configurer dans le provider : webhook -> https://<APP>/api/email/inbound
# Header : X-Webhook-Secret = <ce secret>
INBOUND_EMAIL_SECRET=""

# ─── App URL (pour pixel tracking + liens emails) ──────────
NEXT_PUBLIC_APP_URL="https://vnkautomatisation.ca"

# ─── Note signature électronique ───────────────────────────
# On utilise notre propre canvas de signature (pas Dropbox Sign).
# Le flux : client dessine dans le portail → base64 dans clients_signature_data
# Admin dessine dans /admin/contracts → base64 dans admins_signature_data
# Les deux → contract.status = 'signed' + facture auto générée

# Development only. Set to 1 to skip the sign-in screen locally.
# A production build refuses to start if this is set.
AUTH_DEV_BYPASS=
