  title        String   // "SIMDUT 2015", "Cadenassage/déconsignation"
  category     String   @default("safety") // safety | technical | leadership | compliance | other
  provider     String?  // "CNESST", "Schneider Electric"
  completedAt  DateTime? @map("completed_at") @db.Date
  expiresAt    DateTime? @map("expires_at") @db.Date
