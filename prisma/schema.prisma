}

// ── CNESST : déclarations d'accident travail (obligatoire QC) ──
model CnesstIncident {
  id           Int      @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  reportedBy   Int      @map("reported_by")
  incidentDate DateTime @map("incident_date")
  location     String   // "Atelier rue X", "Chantier client Acme"
  description  String   @db.Text
  injuryType   String?  @map("injury_type") // brûlure, fracture, choc électrique, chute, etc.
  bodyPart     String?  @map("body_part")
  witnessName  String?  @map("witness_name")
  reportedToCnesstAt DateTime? @map("reported_to_cnesst_at")
  cnesstFileNumber String? @map("cnesst_file_number")
  daysAbsent   Int?     @map("days_absent")
  returnedToWorkAt DateTime? @map("returned_to_work_at")
  attachmentUrls Json?  @map("attachment_urls") // array URLs
  status       String   @default("declared") // declared | accepted | refused | closed
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  admin        Admin    @relation("CnesstIncidents", fields: [adminId], references: [id], onDelete: Cascade)
  reporter     Admin    @relation("CnesstReports", fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([incidentDate])
