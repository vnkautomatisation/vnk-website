  privateNotes String?  @map("private_notes") @db.Text // visible manager seulement
  status       String   @default("scheduled") // scheduled | held | cancelled | rescheduled
  heldAt       DateTime? @map("held_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  admin        Admin    @relation("OneOnOnesAsEmployee", fields: [adminId], references: [id], onDelete: Cascade)
  manager      Admin    @relation("OneOnOnesAsManager", fields: [managerId], references: [id], onDelete: Cascade)

  @@index([adminId, scheduledAt])
  @@index([managerId, scheduledAt])
  @@map("one_on_ones")
}

// ── Historique salaires & augmentations ────────────────────
model SalaryHistory {
  id           Int      @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  effectiveDate DateTime @map("effective_date") @db.Date
