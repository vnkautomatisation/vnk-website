  improvements    String?  @db.Text
  objectivesNext  String?  @map("objectives_next") @db.Text
  managerComments String?  @map("manager_comments") @db.Text
  employeeComments String? @map("employee_comments") @db.Text
  submittedAt     DateTime? @map("submitted_at")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  admin           Admin    @relation("PerformanceReviews", fields: [adminId], references: [id], onDelete: Cascade)
  reviewer        Admin    @relation("PerformanceReviewers", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([reviewerId])
  @@map("performance_reviews")
