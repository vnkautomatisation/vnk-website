  @@index([status])
  @@map("project_requests")
}

// ════════════════════════════════════════════════════════════
// SETTINGS (configuration via section Paramètres)
// ════════════════════════════════════════════════════════════



model Setting {
  id          Int         @id @default(autoincrement())
  category    String      // general, company, portal, billing, signature, emails, integrations, system, users, appearance, seo, logs, notifications, legal
  key         String
  value       String?     @db.Text
  type        String     @default("string")
  label       String      // Libellé affiché dans l'UI
  description String?     // Aide contextuelle
  isPublic    Boolean     @default(false) @map("is_public") // exposé au portail/public ?
  isSecret    Boolean     @default(false) @map("is_secret") // masqué dans l'UI
  sortOrder   Int         @default(0) @map("sort_order")
  updatedBy   Int?        @map("updated_by") // admin.id qui a modifié
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  @@unique([category, key])
  @@index([category])
  @@map("settings")
}

// ════════════════════════════════════════════════════════════
// AUDIT LOG (traçabilité complète)
// ════════════════════════════════════════════════════════════

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int?     @map("admin_id")
  action      String   // create | update | delete | login | logout | export | settings_update
  entityType  String   @map("entity_type") // clients | quotes | settings | ...
  entityId    Int?     @map("entity_id")
  changes     Json?    // avant/après
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════════
// INTÉGRATIONS TIERS (Stripe, Dropbox Sign, Zapier, etc.)
// ════════════════════════════════════════════════════════════

model Integration {
  id           Int      @id @default(autoincrement())
  provider     String   // stripe | dropbox_sign | calendly | google | microsoft | sendgrid | zapier
  name         String
  isEnabled    Boolean  @default(false) @map("is_enabled")
  credentials  Json?    // clés API, tokens (chiffrés)
  config       Json?    // config spécifique
  lastSyncAt   DateTime? @map("last_sync_at")
  lastError    String?  @map("last_error")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([provider])
  @@map("integrations")
}

// Webhooks sortants (pour que les clients/partenaires reçoivent des events VNK)
model OutgoingWebhook {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  secret      String   // pour signer le payload HMAC
  events      String[] // ex: ['invoice.paid', 'contract.signed']
  isEnabled   Boolean  @default(true) @map("is_enabled")
  lastFireAt  DateTime? @map("last_fire_at")
  lastStatus  Int?     @map("last_status")
  failCount   Int      @default(0) @map("fail_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("outgoing_webhooks")
}

// Webhooks entrants reçus (pour debug + replay)
model IncomingWebhookLog {
  id          Int      @id @default(autoincrement())
  provider    String   // stripe | calendly | dropbox_sign
  eventType   String   @map("event_type")
  payload     Json
  signature   String?
  verified    Boolean  @default(false)
  processed   Boolean  @default(false)
  error       String?
  receivedAt  DateTime @default(now()) @map("received_at")

  @@index([provider, receivedAt])
  @@map("incoming_webhook_logs")
}

// ════════════════════════════════════════════════════════════
// NOTIFICATIONS (portail + admin)
// ════════════════════════════════════════════════════════════

model Notification {
  id         Int      @id @default(autoincrement())
  recipientType String @map("recipient_type") // admin | client
  recipientId   Int    @map("recipient_id")
  type       String   // info | warning | error | success
  title      String
  body       String?
  link       String?
  icon       String?
  isRead     Boolean  @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([recipientType, recipientId, isRead])
  @@map("notifications")
}

// ════════════════════════════════════════════════════════════
// TEMPLATES EMAILS + PDF (editables via Paramètres)
// ════════════════════════════════════════════════════════════

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique // tpl_new_quote, tpl_invoice_paid, etc.
  locale      String   @default("fr")
  subject     String
  bodyHtml    String   @map("body_html")
  bodyText    String?  @map("body_text")
  variables   Json?    // { clientName: "Nom du client", ... }
  isEnabled   Boolean  @default(true) @map("is_enabled")
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([key, locale])
  @@map("email_templates")
}

model PdfTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique // quote, invoice, contract, report
  locale      String   @default("fr")
  content     Json     // structure JSON du template
  variables   Json?
  isEnabled   Boolean  @default(true) @map("is_enabled")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([key, locale])
  @@map("pdf_templates")
}

// ════════════════════════════════════════════════════════════
// ABONNEMENTS RÉCURRENTS (SaaS support)
// ════════════════════════════════════════════════════════════

model SubscriptionPlan {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  priceMonthly    Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly     Decimal? @map("price_yearly") @db.Decimal(10, 2)
  currency        String   @default("CAD")
  features        Json?    // liste de features
  maxUsers        Int?     @map("max_users")
  maxStorageMb    Int?     @map("max_storage_mb")
  isActive        Boolean  @default(true) @map("is_active")
  stripePriceId   String?  @map("stripe_price_id")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  subscriptions   Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               Int      @id @default(autoincrement())
  clientId         Int      @map("client_id")
  planId           Int      @map("plan_id")
  status           String   @default("active") // active | cancelled | expired | trial
  startedAt        DateTime @map("started_at")
  currentPeriodEnd DateTime @map("current_period_end")
  cancelledAt      DateTime? @map("cancelled_at")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  createdAt        DateTime @default(now()) @map("created_at")

  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([clientId])
  @@map("subscriptions")
}

// ════════════════════════════════════════════════════════════
// CATALOGUE SERVICES + CODES PROMO
// ════════════════════════════════════════════════════════════

model ServiceCatalog {
  id            Int      @id @default(autoincrement())
  key           String   @unique // support_plc, audit, documentation, refactoring
  name          String
  description   String?
  basePrice     Decimal  @map("base_price") @db.Decimal(10, 2)
  priceUnit     String   @default("hour") @map("price_unit") // hour | fixed | day
  currency      String   @default("CAD")
  category      String?
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("service_catalog")
}

model DiscountCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  description  String?
  discountType String    @map("discount_type") // percent | fixed
  value        Decimal   @db.Decimal(10, 2)
  maxUses      Int?      @map("max_uses")
  currentUses  Int       @default(0) @map("current_uses")
  validFrom    DateTime? @map("valid_from")
  validUntil   DateTime? @map("valid_until")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("discount_codes")
}

// ════════════════════════════════════════════════════════════
// BLOG / FAQ / TÉMOIGNAGES (contenu CMS éditable)
// ════════════════════════════════════════════════════════════

model BlogPost {
  id            Int       @id @default(autoincrement())
  locale        String    @default("fr")
  slug          String
  title         String
  excerpt       String?
  contentHtml   String    @map("content_html")
  coverImageUrl String?   @map("cover_image_url")
  authorId      Int?      @map("author_id")
  tags          String[]
  category      String?
  status        String    @default("draft") // draft | published | archived
  publishedAt   DateTime? @map("published_at")
  viewCount     Int       @default(0) @map("view_count")
  seoTitle      String?   @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@index([status, publishedAt])
  @@map("blog_posts")
}

model FaqItem {
  id         Int      @id @default(autoincrement())
  locale     String   @default("fr")
  question   String
  answer     String
  category   String?
  sortOrder  Int      @default(0) @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([locale, isPublished])
  @@map("faq_items")
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  clientName  String   @map("client_name")
  clientCompany String? @map("client_company")
  clientTitle String?  @map("client_title")
  content     String
  rating      Int      @default(5)
  avatarUrl   String?  @map("avatar_url")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isApproved  Boolean  @default(false) @map("is_approved")
  locale      String   @default("fr")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

// ════════════════════════════════════════════════════════════
// MAINTENANCE & STATUT DU SITE
// ════════════════════════════════════════════════════════════

model MaintenanceWindow {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  isActive    Boolean   @default(false) @map("is_active")
  affectsPortal Boolean @default(true) @map("affects_portal")
  affectsAdmin  Boolean @default(false) @map("affects_admin")
  affectsPublic Boolean @default(false) @map("affects_public")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("maintenance_windows")
}

model IncidentReport {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  severity    String    @default("minor")
  status      String    @default("investigating")
  startedAt   DateTime  @default(now()) @map("started_at")
  resolvedAt  DateTime? @map("resolved_at")
  isPublic    Boolean   @default(true) @map("is_public")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("incident_reports")
}

// ════════════════════════════════════════════════════════════
// EVENT SOURCING — capture immuable de tous les événements clients
// ════════════════════════════════════════════════════════════

model EmailEvent {
  id          Int      @id @default(autoincrement())
  clientId    Int?     @map("client_id")
  messageId   String?  @map("message_id") // Resend/SMTP message-id
  type        String   // sent | delivered | opened | clicked | bounced | complained | failed
  email       String
  subject     String?
  link        String?
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clientId, type])
  @@index([messageId])
  @@index([createdAt])
  @@map("email_events")
}

model LoginEvent {
  id          Int      @id @default(autoincrement())
  clientId    Int?     @map("client_id")
  adminId     Int?     @map("admin_id")
  email       String
  type        String   // success | failed | locked | 2fa_challenge | 2fa_success | 2fa_failed | logout
  reason      String?  // wrong_password, account_locked, 2fa_invalid
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  country     String?
  city        String?
  deviceType  String?  @map("device_type") // desktop | mobile | tablet
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@index([adminId, createdAt])
  @@index([email, createdAt])
  @@index([type])
  @@map("login_events")
}

model ConsentLog {
  id          Int      @id @default(autoincrement())
  clientId    Int      @map("client_id")
  consentType String   @map("consent_type") // terms | privacy | marketing | cookies | data_retention
  version     String   // version du document accepte
  granted     Boolean  // true si accepte
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  source      String?  // signup | portal_settings | popup_banner
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clientId, consentType])
  @@index([createdAt])
  @@map("consent_logs")
}

model OrderEvent {
  id              Int      @id @default(autoincrement())
  clientId        Int?     @map("client_id")
  guestEmail      String?  @map("guest_email") // si checkout sans compte
  type            String   // initiated | created | paid | failed | refunded | cancelled | dispute_opened | dispute_updated
  amount          Decimal? @db.Decimal(10, 2)
  currency        String?
  stripeIntentId  String?  @map("stripe_intent_id")
  paymentMethod   String?  @map("payment_method")
  invoiceId       Int?     @map("invoice_id")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  referer         String?
  origin          String?
  geoCountry      String?  @map("geo_country")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([clientId, type])
  @@index([stripeIntentId])
  @@index([createdAt])
  @@map("order_events")
}

model SignatureEvent {
  id              Int      @id @default(autoincrement())
  entityType      String   @map("entity_type") // contract | quote
  entityId        Int      @map("entity_id")
  clientId        Int      @map("client_id")
  signedBy        String   @map("signed_by") // admin email or "client"
  signatureHash   String?  @map("signature_hash") // SHA-256 du PDF signe
  rfc3161Token    String?  @map("rfc3161_token") // token TSA pour horodatage legal
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([clientId])
  @@index([createdAt])
  @@map("signature_events")
}
