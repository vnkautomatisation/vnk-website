// VNK Automatisation — Prisma schema
// Mappe directement les 20 tables existantes (schema.sql + calendar_schema.sql)
// + nouvelles tables pour Paramètres, audit, roles, webhooks, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════
// AUTHENTIFICATION & RÔLES
// ════════════════════════════════════════════════════════════

model Admin {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String?   @map("full_name")
  role          String    @default("admin")
  isActive      Boolean   @default(true) @map("is_active")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  avatarUrl     String?   @map("avatar_url")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  // ── Identité étendue ─────────────────────────────────
  title             String?   // Titre/poste (ex: "Fondateur & developpeur")
  phone             String?
  phoneVerifiedAt   DateTime? @map("phone_verified_at")
  bio               String?   // 280 caracteres max
  emailSignature    String?   @map("email_signature") // Signature mail pro
  presenceStatus    String?   @map("presence_status") // active | meeting | vacation | focus | offline
  presenceMessage   String?   @map("presence_message")
  presenceUntil     DateTime? @map("presence_until")

  // ── Preferences UI/UX ────────────────────────────────
  timezone          String?   @default("America/Toronto")
  locale            String?   @default("fr-CA") // fr-CA | en-CA
  theme             String?   @default("light")  // light | dark | auto
  accentColor       String?   @map("accent_color") // hex pour avatar fallback
  defaultLanding    String?   @map("default_landing") // dashboard | requests | calendar | messages
  notificationPrefs Json?     @map("notification_prefs") // {email:{...}, slack:{...}, push:{...}}
  shortcuts         Json?     // {save:"cmd+s", search:"cmd+k"}

  // ── Securite renforcee ───────────────────────────────
  passwordChangedAt   DateTime? @map("password_changed_at")
  passwordHistory     Json?     @map("password_history") // [{hash, changedAt}]
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  loginAlertsEnabled  Boolean   @default(true) @map("login_alerts_enabled")
  recoveryEmail       String?   @map("recovery_email")
  lastPasswordIp      String?   @map("last_password_ip")

  // ── Loi 25 / Confidentialite ─────────────────────────
  dataExportRequestedAt DateTime? @map("data_export_requested_at")
  dataExportReadyAt     DateTime? @map("data_export_ready_at")
  marketingOptIn        Boolean   @default(false) @map("marketing_opt_in")
  analyticsOptIn        Boolean   @default(true)  @map("analytics_opt_in")

  // Marqueur d'invalidation globale (force la déconnexion de toutes les sessions
  // dont le JWT a été émis AVANT cette date).
  sessionsInvalidatedAt DateTime? @map("sessions_invalidated_at")

  // ── Onboarding ───────────────────────────────────────
  onboardingDone    Boolean   @default(false) @map("onboarding_done")
  onboardingSteps   Json?     @map("onboarding_steps") // {profile:true, twoFa:false, ...}

  // ── Identité étendue (poste, département, équipe) ──
  positionId        Int?     @map("position_id")
  roleId            Int?     @map("role_id")
  department        String?  // « Comptabilité », « Ventes », « Technique »
  startDate         DateTime? @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  birthdate         DateTime? @map("birthdate") @db.Date // pour anniversaires + dossier employé
  internalNotes     String?  @map("internal_notes")

  // ── Fondateur : un super_admin sans superieur hierarchique a le droit de tout faire,
  // y compris approuver ses propres heures. Les autres super_admin/managers ne peuvent
  // pas approuver leurs propres heures — leur superieur le fait.
  isFounder         Boolean  @default(false) @map("is_founder")

  // ── Sous-équipes : appartenance à un Team + supérieur hiérarchique ──
  teamId            Int?     @map("team_id")
  managerId         Int?     @map("manager_id")

  // ── Politique de congés assignée (null = politique par défaut) ──
  leavePolicyId     Int?     @map("leave_policy_id")

  // ── Délégation d'approbation : à qui les demandes vont en mon absence ──
  delegateApprovalTo Int?    @map("delegate_approval_to")

  // ── Blocage admin : empêche l'employé de soumettre des congés ──
  leaveBlockedUntil  DateTime? @map("leave_blocked_until")
  leaveBlockedReason String?   @map("leave_blocked_reason")

  auditLogs        AuditLog[]
  sessions         AdminSession[]
  assignedPayments Payment[] @relation("AssignedPayments")
  backupCodes      AdminBackupCode[]
  trustedDevices   AdminTrustedDevice[]
  apiTokens        AdminApiToken[]
  securityEvents   AdminSecurityEvent[]
  passkeys         AdminPasskey[]
  team             Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeams         Team[]   @relation("TeamLead")
  manager          Admin?   @relation("AdminManager", fields: [managerId], references: [id])
  directReports    Admin[]  @relation("AdminManager")

  // ── Module RH ─────────────────────────────────────────
  contracts        EmployeeContract[] @relation("EmployeeContracts")
  employerContractSignatures EmployeeContract[] @relation("EmployerSignatures")
  legalSignatures  LegalDocumentSignature[] @relation("LegalSignatures")
  timeClocks       TimeClock[] @relation("TimeClocks")
  timeClockApprovals TimeClock[] @relation("TimeClockApprovers")
  timeClockEditRequests       TimeClockEditRequest[] @relation("TimeClockEditRequests")
  timeClockEditRequestReviews TimeClockEditRequest[] @relation("TimeClockEditReviewer")
  timeClockHistoryActions     TimeClockHistory[]     @relation("TimeClockHistoryActor")
  payStubs         PayStub[] @relation("PayStubs")
  leaveRequests    LeaveRequest[] @relation("LeaveRequests")
  leaveReviews     LeaveRequest[] @relation("LeaveReviewers")
  leavePolicy      LeavePolicy?   @relation(fields: [leavePolicyId], references: [id])
  leaveBalances    LeaveBalance[] @relation("LeaveBalances")
  leaveAccruals    LeaveAccrual[] @relation("LeaveAccruals")
  vacationPreferences VacationPreference[] @relation("VacationPreferences")
  delegate         Admin?         @relation("Delegate", fields: [delegateApprovalTo], references: [id])
  delegatesFrom    Admin[]        @relation("Delegate")

  // ── Dossier employé étendu ───────────────────────────
  emergencyContacts        EmergencyContact[] @relation("EmergencyContacts")
  bankInfo                 BankInfo? @relation("BankInfo")
  familyDependents         FamilyDependent[] @relation("FamilyDependents")
  professionalLicenses     ProfessionalLicense[] @relation("ProfessionalLicenses")
  employeeFiles            EmployeeFile[] @relation("EmployeeFiles")
  employeeFilesUploaded    EmployeeFile[] @relation("EmployeeFilesUploaded")
  employeeNotes            EmployeeNote[] @relation("EmployeeNotes")
  employeeNotesAuthored    EmployeeNote[] @relation("EmployeeNotesAuthor")
  assignedEquipment        AssignedEquipment[] @relation("AssignedEquipment")
  trainingRecords          TrainingRecord[] @relation("TrainingRecords")
  cnesstIncidents          CnesstIncident[] @relation("CnesstIncidents")
  cnesstReports            CnesstIncident[] @relation("CnesstReports")
  performanceReviews       PerformanceReview[] @relation("PerformanceReviews")
  performanceReviewsAsReviewer PerformanceReview[] @relation("PerformanceReviewers")
  oneOnOnesAsEmployee      OneOnOneMeeting[] @relation("OneOnOnesAsEmployee")
  oneOnOnesAsManager       OneOnOneMeeting[] @relation("OneOnOnesAsManager")
  salaryHistory            SalaryHistory[] @relation("SalaryHistory")
  salaryApprovals          SalaryHistory[] @relation("SalaryApprovals")
  bonuses                  BonusRecord[] @relation("Bonuses")
  bonusApprovals           BonusRecord[] @relation("BonusApprovals")
  workSchedule             WorkSchedule? @relation("WorkSchedule")
  announcements            Announcement[] @relation("Announcements")
  announcementReads        AnnouncementRead[] @relation("AnnouncementReadsByAdmin")
  taxDocuments             TaxDocument[] @relation("TaxDocuments")
  taxDocumentsIssued       TaxDocument[] @relation("TaxDocumentsIssued")
  letterRequests           EmploymentLetterRequest[] @relation("LetterRequests")
  letterRequestsIssued     EmploymentLetterRequest[] @relation("LetterRequestsIssued")
  offboardingAsEmployee    OffboardingChecklist? @relation("OffboardingAsEmployee")
  offboardingInitiated     OffboardingChecklist[] @relation("OffboardingInitiator")
  offboardingSuccessor     OffboardingChecklist[] @relation("OffboardingSuccessor")
  hrPolicies               HrPolicy[] @relation("HrPolicies")

  position         Position? @relation(fields: [positionId], references: [id])
  customRole       Role?     @relation(fields: [roleId], references: [id])

  @@index([teamId])
  @@index([managerId])
  @@map("admins")
}

// ── Passkeys WebAuthn (login sans mot de passe) ────────────
model AdminPasskey {
  id            Int      @id @default(autoincrement())
  adminId       Int      @map("admin_id")
  credentialId  String   @unique @map("credential_id") // base64url
  publicKey     String   @map("public_key") @db.Text   // SPKI base64
  counter       BigInt   @default(0)
  transports    String?  // "usb,nfc,internal,hybrid"
  deviceLabel   String?  @map("device_label")          // "iPhone Yan", "YubiKey 5"
  backupEligible Boolean @default(false) @map("backup_eligible")
  backupState    Boolean @default(false) @map("backup_state")
  aaguid        String?
  createdAt     DateTime @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")

  admin         Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_passkeys")
}

// ── Challenges éphémères WebAuthn (registration + auth) ─────
model WebAuthnChallenge {
  id          Int      @id @default(autoincrement())
  challenge   String   @unique  // base64url
  adminId     Int?     @map("admin_id")   // null si flow d'auth (email pas encore donné)
  email       String?  // pour flow d'auth par email
  purpose     String   // "registration" | "authentication"
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ═══════════════════════════════════════════════════════════
// MODULE EMPLOYÉS — contrats, documents légaux, pointage, paie, congés
// ═══════════════════════════════════════════════════════════

// ── Templates de contrats associés aux postes ──────────────
model ContractTemplate {
  id             Int      @id @default(autoincrement())
  name           String   // « Contrat CDI Comptable », « Contrat stagiaire »
  positionId     Int?     @map("position_id")
  contractType   String   @map("contract_type") // cdi | cdd | contractuel | stagiaire | autre
  bodyMarkdown   String   @map("body_markdown") @db.Text
  defaultSalary  Decimal? @map("default_salary") @db.Decimal(10, 2)
  defaultRate    Decimal? @map("default_rate") @db.Decimal(8, 2)
  defaultHoursPerWeek Int? @map("default_hours_per_week")
  defaultVacationPct  Decimal? @default(4.0) @map("default_vacation_pct") @db.Decimal(4, 2)
  probationDays  Int?     @default(90) @map("probation_days")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  position       Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  contracts      EmployeeContract[]

  @@map("contract_templates")
}

// ── Contrat signé d'un employé ─────────────────────────────
model EmployeeContract {
  id              Int      @id @default(autoincrement())
  adminId         Int      @map("admin_id")
  templateId      Int?     @map("template_id")
  title           String   // « Contrat CDI - Yan Verone »
  contractType    String   @map("contract_type")
  bodyMarkdown    String   @map("body_markdown") @db.Text
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  probationEndDate DateTime? @map("probation_end_date") @db.Date
  salaryAnnual    Decimal? @map("salary_annual") @db.Decimal(10, 2)
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(8, 2)
  hoursPerWeek    Int?     @map("hours_per_week")
  vacationPct     Decimal? @map("vacation_pct") @db.Decimal(4, 2)
  currency        String   @default("CAD")

  // ── Double signature ────────────────────────────────────
  employeeSignatureData String? @map("employee_signature_data") @db.Text // data URL PNG
  employeeSignedAt      DateTime? @map("employee_signed_at")
  employeeSignedIp      String? @map("employee_signed_ip")
  employerSignatureData String? @map("employer_signature_data") @db.Text
  employerSignedAt      DateTime? @map("employer_signed_at")
  employerSignedIp      String? @map("employer_signed_ip")
  employerAdminId       Int? @map("employer_admin_id") // qui a signé côté employeur

  status          String   @default("draft") // draft | sent | signed_employee | signed_employer | active | terminated | expired
  terminatedAt    DateTime? @map("terminated_at")
  terminationReason String? @map("termination_reason")
  pdfUrl          String?  @map("pdf_url") // PDF signé archivé

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  admin           Admin    @relation("EmployeeContracts", fields: [adminId], references: [id], onDelete: Cascade)
  template        ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employer        Admin?   @relation("EmployerSignatures", fields: [employerAdminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([status])
  @@map("employee_contracts")
}

// ── Documents légaux à faire signer aux employés ───────────
model LegalDocumentTemplate {
  id           Int      @id @default(autoincrement())
  key          String   @unique // nda | code_conduct | harassment_policy | security_policy | data_policy
  title        String
  category     String   @default("policy") // policy | nda | acknowledgment
  version      String   @default("1.0")
  bodyMarkdown String   @map("body_markdown") @db.Text
  isRequired   Boolean  @default(true) @map("is_required")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  signatures   LegalDocumentSignature[]

  @@map("legal_document_templates")
}

model LegalDocumentSignature {
  id          Int      @id @default(autoincrement())
  templateId  Int      @map("template_id")
  adminId     Int      @map("admin_id")
  version     String   // copie au moment de la signature pour archive immuable
  signatureData String? @map("signature_data") @db.Text
  signedAt    DateTime @default(now()) @map("signed_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  template    LegalDocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  admin       Admin    @relation("LegalSignatures", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([templateId, adminId, version])
  @@index([adminId])
  @@map("legal_document_signatures")
}

// ── Pointage horaire employé (distinct de TimeEntry qui est facturable client) ──
model TimeClock {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  clockIn     DateTime @map("clock_in")
  clockOut    DateTime? @map("clock_out")
  durationMin Int?     @map("duration_min") // calcule = (clockOut - clockIn) - totalBreakMin
  category    String   @default("work") // work | break | meeting | training | sick | vacation
  notes       String?
  // ── Pauses cumulees (au lieu de creer N pointages separes) ───
  // Pause  : pausedAt = now
  // Reprendre : totalBreakMin += (now - pausedAt) ; pausedAt = null
  // Arreter : si pausedAt non null on ferme d'abord la pause
  pausedAt    DateTime? @map("paused_at")
  totalBreakMin Int     @default(0) @map("total_break_min")
  // ── Code de tache (obligatoire au clock-in, choisi parmi les codes du poste) ─
  jobCodeId   Int?     @map("job_code_id")
  // ── Flag : saisie manuelle (rattrapage) vs clock-in/out reel ──
  // Une saisie manuelle = l'employe declare ses heures, le detail des pauses
  // n'est pas tracke. La regle "pause manquante CNESST" ne s'applique pas
  // aux jours uniquement composes de saisies manuelles.
  isManual    Boolean  @default(false) @map("is_manual")
  approvedBy  Int?     @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  submittedAt DateTime? @map("submitted_at") // soumission par l'employé (revue à valider)
  payStubId   Int?     @map("pay_stub_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  admin       Admin    @relation("TimeClocks", fields: [adminId], references: [id], onDelete: Cascade)
  approver    Admin?   @relation("TimeClockApprovers", fields: [approvedBy], references: [id], onDelete: SetNull)
  payStub     PayStub? @relation(fields: [payStubId], references: [id], onDelete: SetNull)
  jobCode     JobCode? @relation(fields: [jobCodeId], references: [id], onDelete: SetNull)
  history     TimeClockHistory[]

  @@index([adminId, clockIn])
  @@index([payStubId])
  @@index([jobCodeId])
  @@map("time_clocks")
}

// ── Historique des actions sur un pointage ────────────────
// Trace chaque approbation, annulation, rejet, edition pour audit fin et
// affichage utilisateur ("approuvé par X le 24 mai"). Remplace le préfixage
// historique dans `notes`.
model TimeClockHistory {
  id          Int      @id @default(autoincrement())
  timeClockId Int      @map("time_clock_id")
  actorId     Int      @map("actor_id")
  event       String   // "approved" | "unapproved" | "rejected" | "edited"
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  timeClock   TimeClock @relation(fields: [timeClockId], references: [id], onDelete: Cascade)
  actor       Admin     @relation("TimeClockHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([timeClockId, createdAt])
  @@map("time_clock_history")
}

// ── Demande de modification de pointage post-soumission ───
// L'employe demande a debloquer des entrees deja submittedAt (cadenas) pour les editer.
// Un admin peut accorder (deverrouille les entries) ou refuser (notif explicative).
model TimeClockEditRequest {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  entryIds    Json     @map("entry_ids") // array of TimeClock ids
  reason      String
  status      String   @default("pending") // pending | granted | denied
  reviewerId  Int?     @map("reviewer_id")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNote  String?  @map("review_note")
  createdAt   DateTime @default(now()) @map("created_at")

  admin       Admin    @relation("TimeClockEditRequests", fields: [adminId], references: [id], onDelete: Cascade)
  reviewer    Admin?   @relation("TimeClockEditReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("timeclock_edit_requests")
}

// Snapshot pour l'undo des actions destructives sur les pointages (merge/delete-shorts/reject).
// Le payload contient l'etat des entrees affectees au format JSON, restaurable pendant ~24h.
model TimeClockSnapshot {
  id          Int       @id @default(autoincrement())
  actorId     Int       @map("actor_id")
  reason      String    // merge_day | delete_short | reject
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  restoredAt  DateTime? @map("restored_at")
  expiresAt   DateTime  @map("expires_at")

  @@index([actorId, createdAt])
  @@map("time_clock_snapshots")
}

// ── Cycles de paie ──────────────────────────────────────────
model PayPeriod {
  id          Int      @id @default(autoincrement())
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  payDate     DateTime @map("pay_date") @db.Date
  status      String   @default("open") // open | locked | paid
  lockedAt    DateTime? @map("locked_at")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  stubs       PayStub[]

  @@index([startDate, endDate])
  @@map("pay_periods")
}

// ── Bulletin de paie ────────────────────────────────────────
model PayStub {
  id              Int      @id @default(autoincrement())
  periodId        Int      @map("period_id")
  adminId         Int      @map("admin_id")
  hoursRegular    Decimal  @default(0) @map("hours_regular") @db.Decimal(6, 2)
  hoursOvertime   Decimal  @default(0) @map("hours_overtime") @db.Decimal(6, 2)
  hoursVacation   Decimal  @default(0) @map("hours_vacation") @db.Decimal(6, 2)
  hoursSick       Decimal  @default(0) @map("hours_sick") @db.Decimal(6, 2)
  rate            Decimal  @default(0) @map("rate") @db.Decimal(8, 2)
  grossPay        Decimal  @default(0) @map("gross_pay") @db.Decimal(10, 2)
  // Déductions à la source Québec (provisoires — calcul réel via service externe en prod)
  deductionFederal Decimal @default(0) @map("deduction_federal") @db.Decimal(10, 2)
  deductionProvincial Decimal @default(0) @map("deduction_provincial") @db.Decimal(10, 2)
  deductionRrq    Decimal  @default(0) @map("deduction_rrq") @db.Decimal(10, 2) // Régime rentes Québec
  deductionAe     Decimal  @default(0) @map("deduction_ae") @db.Decimal(10, 2)  // Assurance-emploi
  deductionRqap   Decimal  @default(0) @map("deduction_rqap") @db.Decimal(10, 2) // Régime québécois assurance parentale
  deductionOther  Decimal  @default(0) @map("deduction_other") @db.Decimal(10, 2)
  netPay          Decimal  @default(0) @map("net_pay") @db.Decimal(10, 2)
  notes           String?
  pdfUrl          String?  @map("pdf_url")
  releasedAt      DateTime? @map("released_at") // visible à l'employé
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  period          PayPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  admin           Admin    @relation("PayStubs", fields: [adminId], references: [id], onDelete: Cascade)
  timeClocks      TimeClock[]

  @@unique([periodId, adminId])
  @@index([adminId])
  @@map("pay_stubs")
}

// ── Demandes de congé ───────────────────────────────────────
model LeaveRequest {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  type        String   // vacation | sick | parental | unpaid | bereavement | other
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  daysCount   Decimal  @map("days_count") @db.Decimal(4, 2)
  reason      String?
  status      String   @default("pending") // pending | approved | rejected | cancelled
  reviewerId  Int?     @map("reviewer_id")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNotes String?  @map("review_notes")
  // ── Demi-journee : "AM" / "PM" / null. Si non null, daysCount = 0.5 ──
  halfDay     String?  @map("half_day")
  // ── Lien avec le balance utilise (V2 CNESST) ──
  balanceId   Int?     @map("balance_id")
  // ── Escalade automatique apres 48h sans revue ──
  escalatedAt DateTime? @map("escalated_at")
  // ── Justificatif (certificat médical, document, etc.) ──
  attachmentUrl  String? @map("attachment_url")
  attachmentName String? @map("attachment_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  admin       Admin    @relation("LeaveRequests", fields: [adminId], references: [id], onDelete: Cascade)
  reviewer    Admin?   @relation("LeaveReviewers", fields: [reviewerId], references: [id], onDelete: SetNull)
  balance     LeaveBalance? @relation(fields: [balanceId], references: [id], onDelete: SetNull)
  // Une demande de conge peut etre issue de l'attribution d'une preference (vacation bidding)
  vacationPreferences VacationPreference[] @relation("VacationPreferenceLeave")

  @@index([adminId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// ── Fenetre de selection de vacances (vacation bidding) ──
// Cycle : draft -> open -> closed -> in_review -> allocated -> archived
//   draft     : configuree par RH, pas encore visible
//   open      : entre openingDate et closingDate, employes soumettent leurs preferences
//   closed    : fenetre fermee (manuel ou auto), plus de soumissions ; attente revue RH
//   in_review : RH revise / ajuste les preferences avant attribution finale
//   allocated : les LeaveRequest ont ete creees a partir des preferences accordees
//   archived  : fenetre passee, lecture seule, conserve historique
model VacationSelectionWindow {
  id              Int      @id @default(autoincrement())
  name            String   // "Vacances ete 2026", "Vacances Noel 2026"
  // Periode pendant laquelle les employes peuvent soumettre
  openingDate     DateTime @map("opening_date")
  closingDate     DateTime @map("closing_date")
  // Periode de vacances couverte (ex: 1er juin -> 30 sept pour ete)
  coversFrom      DateTime @map("covers_from") @db.Date
  coversTo        DateTime @map("covers_to") @db.Date
  // Plafond de jours qu'un employe peut demander dans cette fenetre
  maxDaysPerEmployee Int   @default(10) @map("max_days_per_employee")
  // Methode d'attribution : "seniority" (par anciennete), "fcfs" (premier arrive), "manual"
  allocationMethod String  @default("seniority") @map("allocation_method")
  status          String   @default("draft") // "draft" | "open" | "closed" | "in_review" | "allocated" | "archived"
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  preferences     VacationPreference[]

  @@index([status, openingDate])
  @@map("vacation_selection_windows")
}

// ── Preference soumise par un employe pour une fenetre ──
// rank : 1 = choix prefere, 2 = fallback, 3 = dernier recours
// status : "pending" (en attente attribution) | "granted" (attribue) | "denied"
// Si granted, leaveRequestId pointe sur la LeaveRequest approuvee creee
model VacationPreference {
  id              Int      @id @default(autoincrement())
  windowId        Int      @map("window_id")
  adminId         Int      @map("admin_id")
  rank            Int      // 1, 2, 3, ...
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  daysCount       Decimal  @map("days_count") @db.Decimal(4, 2)
  status          String   @default("pending") // "pending" | "granted" | "denied"
  leaveRequestId  Int?     @map("leave_request_id")
  notes           String?
  // ── Workflow appel (R5) : un employe peut faire appel d'une attribution ──
  appealReason     String?   @map("appeal_reason")
  appealStatus     String?   @map("appeal_status") // pending | approved | rejected
  appealedAt       DateTime? @map("appealed_at")
  appealReviewedBy Int?      @map("appeal_reviewed_by")
  appealReviewedAt DateTime? @map("appeal_reviewed_at")
  appealReviewNotes String?  @map("appeal_review_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  window          VacationSelectionWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  admin           Admin   @relation("VacationPreferences", fields: [adminId], references: [id], onDelete: Cascade)
  leaveRequest    LeaveRequest? @relation("VacationPreferenceLeave", fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([windowId, adminId, rank])
  @@index([windowId, adminId])
  @@index([windowId, status])
  @@map("vacation_preferences")
}

// ── Politique de congés CNESST configurable par employé ────
// Permet de definir les regles d'accumulation, quotas et carry-over.
// Une politique par defaut (isDefault=true) est appliquee aux nouveaux employes.
model LeavePolicy {
  id                  Int      @id @default(autoincrement())
  name                String   @unique
  // Periode de reference CNESST : 1er mai N -> 30 avril N+1 par defaut
  referenceMonthStart Int      @default(5) @map("reference_month_start")
  // Taux d'accumulation (% du temps travaille). 4% = 2 sem, 6% = 3 sem (CNESST)
  accrualRateBelow3y  Decimal  @default(4) @map("accrual_rate_below_3y") @db.Decimal(5, 2)
  accrualRateAbove3y  Decimal  @default(6) @map("accrual_rate_above_3y") @db.Decimal(5, 2)
  // Preavis minimum (jours) pour les vacances
  vacationNoticeDays  Int      @default(7) @map("vacation_notice_days")
  minConsecutiveDays  Int      @default(1) @map("min_consecutive_days")
  maxConsecutiveDays  Int      @default(30) @map("max_consecutive_days")
  // Carry-over : nb max de jours reportables, duree en mois
  carryOverDays       Int      @default(0) @map("carry_over_days")
  carryOverMonths     Int      @default(12) @map("carry_over_months")
  // Quotas annuels (null = pas de quota fixe)
  sickDaysPerYear     Int?     @map("sick_days_per_year")
  personalDaysPerYear Int?     @map("personal_days_per_year")
  isDefault           Boolean  @default(false) @map("is_default")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  admins              Admin[]

  @@map("leave_policies")
}

// ── Solde de conges (snapshot par periode et par type) ──────
// Une ligne par (admin, type, periode). Mis a jour par accrueWeek + lors des
// review/cancel sur LeaveRequest. La somme accrued + carriedOver - taken -
// planned = solde disponible.
model LeaveBalance {
  id              Int      @id @default(autoincrement())
  adminId         Int      @map("admin_id")
  type            String   // vacation | sick | personal
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  accruedDays     Decimal  @default(0) @map("accrued_days") @db.Decimal(6, 2)
  takenDays       Decimal  @default(0) @map("taken_days") @db.Decimal(6, 2)
  plannedDays     Decimal  @default(0) @map("planned_days") @db.Decimal(6, 2)
  carriedOverDays Decimal  @default(0) @map("carried_over_days") @db.Decimal(6, 2)
  quotaDays       Decimal? @map("quota_days") @db.Decimal(6, 2)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  admin           Admin    @relation("LeaveBalances", fields: [adminId], references: [id], onDelete: Cascade)
  accruals        LeaveAccrual[]
  requests        LeaveRequest[]

  @@unique([adminId, type, periodStart])
  @@index([adminId, periodEnd])
  @@map("leave_balances")
}

// ── Accumulation hebdomadaire (trace immuable pour audit) ──
// Cree chaque semaine par le cron : recolte les heures travaillees du
// LeaveAccrual.weekStart -> +7j, calcule les jours accumulés via le taux
// CNESST applicable (ancienneté de l'employé), et bump le LeaveBalance.
model LeaveAccrual {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  balanceId   Int      @map("balance_id")
  weekStart   DateTime @map("week_start") @db.Date
  hoursWorked Decimal  @default(0) @map("hours_worked") @db.Decimal(6, 2)
  accruedDays Decimal  @default(0) @map("accrued_days") @db.Decimal(6, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  admin       Admin        @relation("LeaveAccruals", fields: [adminId], references: [id], onDelete: Cascade)
  balance     LeaveBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@unique([adminId, weekStart, balanceId])
  @@index([balanceId])
  @@map("leave_accruals")
}

