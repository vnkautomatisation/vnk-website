  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  status          String   @default("draft") // draft | submitted | reviewed | acknowledged | closed
  rating          Int?     // 1-5 ou 1-10
