  admin        Admin    @relation("EmployeeFiles", fields: [adminId], references: [id], onDelete: Cascade)
  uploader     Admin?   @relation("EmployeeFilesUploaded", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([adminId, category])
  @@map("employee_files")
}

// ── Notes et avis dans le dossier employe ────────────────────
// Notes RH génériques, avis disciplinaires, mentions de mérite,
// rapports d'incidents, observations manager, etc.
model EmployeeNote {
  id           Int      @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  authorId     Int      @map("author_id")
  category     String   // general | discipline | commendation | observation | medical | onboarding | exit
  severity     String?  // info | warning | critical (surtout pour discipline)
  title        String
  body         String   @db.Text
  isConfidential Boolean @default(true) @map("is_confidential") // Confidentiel : visible RH+manager+super_admin uniquement
  acknowledgedAt DateTime? @map("acknowledged_at") // L'employe a confirme avoir lu la note (pour avis disciplinaires)
  occurredAt   DateTime? @map("occurred_at") // Date de l'evenement decrit (si different de createdAt)
  attachmentUrl String? @map("attachment_url") // PDF rapport medical, photo, etc.
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  admin        Admin    @relation("EmployeeNotes", fields: [adminId], references: [id], onDelete: Cascade)
  author       Admin    @relation("EmployeeNotesAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([adminId, category, createdAt])
  @@index([adminId, occurredAt])
  @@map("employee_notes")
}

// ── Équipement attribué (laptop, outils, EPI, voiture) ─────
