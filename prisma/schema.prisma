// ── Documents fiscaux (T4, Relevé 1, lettre emploi) ────────
model TaxDocument {
  id           Int      @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  type         String   // t4 | releve1 | employment_letter | nr4 | t2200 | other
  taxYear      Int?     @map("tax_year") // 2024, 2025
  title        String
  fileUrl      String   @map("file_url")
  issuedAt     DateTime @default(now()) @map("issued_at")
  issuedBy     Int      @map("issued_by")
  notes        String?

  admin        Admin    @relation("TaxDocuments", fields: [adminId], references: [id], onDelete: Cascade)
  issuer       Admin    @relation("TaxDocumentsIssued", fields: [issuedBy], references: [id], onDelete: Cascade)

  @@index([adminId, taxYear])
  @@map("tax_documents")
}

// ── Demandes de lettres d'emploi ───────────────────────────
model EmploymentLetterRequest {
  id           Int      @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  purpose      String   // bank | rental | embassy | hypothec | other
  recipient    String?  // destinataire ("Banque XYZ")
  includeSalary Boolean @default(true) @map("include_salary")
  notes        String?
  status       String   @default("pending") // pending | issued | rejected
  letterUrl    String?  @map("letter_url")
  issuedAt     DateTime? @map("issued_at")
  issuedBy     Int?     @map("issued_by")
  createdAt    DateTime @default(now()) @map("created_at")

  admin        Admin    @relation("LetterRequests", fields: [adminId], references: [id], onDelete: Cascade)
  issuer       Admin?   @relation("LetterRequestsIssued", fields: [issuedBy], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@map("employment_letter_requests")
}

// ── Checklist d'offboarding (sortie d'emploi) ──────────────
model OffboardingChecklist {
  id              Int      @id @default(autoincrement())
  adminId         Int      @unique @map("admin_id")
  initiatedBy     Int      @map("initiated_by")
  reason          String?  // resignation | termination | retirement | end_contract
  lastDay         DateTime? @map("last_day") @db.Date
  // Items checklist (JSON)
  items           Json     @default("[]") // [{ key, label, done, doneAt, doneBy }]
  successorId     Int?     @map("successor_id")
  exitInterview   String?  @map("exit_interview") @db.Text
  exitInterviewAt DateTime? @map("exit_interview_at")
  recordOfEmploymentSentAt DateTime? @map("re_sent_at") // Relevé d'emploi EDSC
  finalPayDate    DateTime? @map("final_pay_date") @db.Date
  status          String   @default("active") // active | completed | cancelled
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  admin           Admin    @relation("OffboardingAsEmployee", fields: [adminId], references: [id], onDelete: Cascade)
  initiator       Admin    @relation("OffboardingInitiator", fields: [initiatedBy], references: [id], onDelete: Cascade)
  successor       Admin?   @relation("OffboardingSuccessor", fields: [successorId], references: [id], onDelete: SetNull)

  @@map("offboarding_checklists")
}

// ── Politiques RH internes (harcèlement, IT, télétravail, etc.) ──
// Distinct des LegalDocumentTemplate qui sont les docs signés.
// HrPolicy = référence + version publiée pour consultation.
model HrPolicy {
  id           Int      @id @default(autoincrement())
  key          String   @unique // "harassment" | "remote_work" | "it_usage" | "code_of_conduct"
  title        String
  version      String
  bodyMarkdown String   @db.Text @map("body_markdown")
  effectiveFrom DateTime @map("effective_from") @db.Date
  isActive     Boolean  @default(true) @map("is_active")
  publishedBy  Int      @map("published_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  publisher    Admin    @relation("HrPolicies", fields: [publishedBy], references: [id], onDelete: Cascade)

  @@map("hr_policies")
}

// ── Sous-équipes / cellules organisationnelles ──────────────
model Team {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  color       String?  @default("#0F2D52")
  // Lead = chef d'équipe (optionnel — sinon hiérarchie pure via managerId)
  leadAdminId Int?     @map("lead_admin_id")
  parentTeamId Int?    @map("parent_team_id")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  lead        Admin?   @relation("TeamLead", fields: [leadAdminId], references: [id], onDelete: SetNull)
  parent      Team?    @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children    Team[]   @relation("TeamHierarchy")
  members     Admin[]  @relation("TeamMembers")

  @@index([parentTeamId])
  @@map("teams")
}

// ── Rôles personnalisables avec matrice de permissions ──────
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // "Comptable", "Vendeur senior", etc.
  description String?
  // Matrice JSON : { "clients": ["read","write"], "invoices": ["read","write","delete"], ... }
  permissions Json     @default("{}")
  // Système = créé au seed, non supprimable
  isSystem    Boolean  @default(false) @map("is_system")
  // Couleur pour l'UI (badge)
  color       String?  @default("#0F2D52")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  admins      Admin[]
  positions   Position[]

  @@map("roles")
}

// ── Postes prédéfinis (templates de profils) ────────────────
model Position {
  id              Int      @id @default(autoincrement())
  name            String   @unique // "Comptable", "Vendeur", "Technicien"
  description     String?
  defaultRoleId   Int?     @map("default_role_id")
  // Préférences par défaut héritées par l'employé
  defaultDepartment String? @map("default_department")
  // Couleur pour le badge sur les listes admins
  color           String?  @default("#0F2D52")
  isSystem        Boolean  @default(false) @map("is_system")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  defaultRole     Role?    @relation(fields: [defaultRoleId], references: [id])
  admins          Admin[]
  contractTemplates ContractTemplate[]
  jobCodes        JobCode[]

  @@map("positions")
}

// ─── Codes de tache par poste ──────────────────────────────
// Chaque poste a sa propre liste de codes (ex: comptable -> COMPTA-001..N,
// programmeur -> DEV-001..N). Un code appartient a UN poste.
// Le pointage exige obligatoirement un code au clock-in.
model JobCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  label       String
  positionId  Int      @map("position_id")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  timeClocks  TimeClock[]

  @@index([positionId, isActive])
  @@map("job_codes")
}

// ── Réinitialisation de mot de passe (flow "mot de passe oublié") ──
// Pattern : email saisi → token + code 6 chiffres envoyés par mail → user
// saisit le code + nouveau mot de passe. Token expire 30 min, max 5 essais.
model PasswordResetToken {
  id           Int      @id @default(autoincrement())
  email        String
  adminId      Int?     @map("admin_id") // null si email inconnu (anti enum)
  clientId     Int?     @map("client_id") // si reset client
  tokenHash    String   @unique @map("token_hash") // SHA-256 du token URL
  codeHash     String   @map("code_hash") // SHA-256 du code à 6 chiffres
  attempts     Int      @default(0) // nb essais code erroné
  expiresAt    DateTime @map("expires_at")
  usedAt       DateTime? @map("used_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([email, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ── Invitations d'utilisateurs admin (lien single-use) ──
// Pattern Slack/Stripe : l'admin crée une invitation, l'employé reçoit un lien
// signé HMAC + token aléatoire qui expire en 7 jours. À l'acceptation, l'employé
// crée son propre mot de passe et active sa 2FA. Anti-pattern évité : pas de
// mot de passe en clair affiché à l'admin créateur.
model AdminInvitation {
  id            Int      @id @default(autoincrement())
  email         String
  fullName      String?  @map("full_name")
  title         String?
  phone         String?
  department    String?
  roleId        Int?     @map("role_id")
  positionId    Int?     @map("position_id")
  tokenHash     String   @unique @map("token_hash") // SHA-256 du token brut
  invitedById   Int      @map("invited_by_id")
  expiresAt     DateTime @map("expires_at")
  acceptedAt    DateTime? @map("accepted_at")
  acceptedAdminId Int?   @map("accepted_admin_id") // id du compte créé après acceptation
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([email, acceptedAt])
  @@index([expiresAt])
  @@map("admin_invitations")
}

// ── Abonnements Web Push (notifications navigateur) ──
model PushSubscription {
  id           Int      @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  endpoint     String   @unique @db.Text
  p256dh       String   @db.Text // clé publique du destinataire
  authKey      String   @map("auth_key") @db.Text
  userAgent    String?  @map("user_agent") @db.Text
  label        String?  // ex : "Chrome bureau"
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("push_subscriptions")
}

// ── CatalogItem : registre générique pour catalogues simples ──
// Couvre : client_tag, client_source, industry, expense_category,
// workflow_status, currency, payment_method, contact_method.
// Évite de multiplier les tables pour des listes plates.
model CatalogItem {
  id          Int      @id @default(autoincrement())
  type        String   // ex : "client_tag", "industry", "workflow_status"
  key         String   // slug identifiant
  name        String   // libellé affiché
  description String?
  color       String?  @default("#0F2D52")
  icon        String?  // nom Lucide ou emoji
  metadata    Json?    // données type-spécifiques (code ISO devise, taux, etc.)
  parentId    Int?     @map("parent_id") // pour catégories hiérarchiques
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([type, key])
  @@index([type, isActive, sortOrder])
  @@map("catalog_items")
}

model AdminSession {
  id           String   @id @default(cuid())
  adminId      Int      @map("admin_id")
  token        String   @unique
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  // ── Enrichissements 2026 ─────────────────────────────
  lastActiveAt DateTime? @map("last_active_at")
  browser      String?
  os           String?
  deviceType   String?  @map("device_type") // desktop | mobile | tablet
  country      String?
  city         String?
  label        String?  // libelle personnalise ("Macbook bureau")
  isCurrent    Boolean  @default(false) @map("is_current")

  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([adminId, lastActiveAt])
  @@map("admin_sessions")
}

// ── 2FA: codes de recuperation one-time ────────────────
model AdminBackupCode {
  id        Int      @id @default(autoincrement())
  adminId   Int      @map("admin_id")
  codeHash  String   @map("code_hash") // SHA-256 du code
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_backup_codes")
}

// ── Appareils de confiance (skip 2FA pendant N jours) ──
model AdminTrustedDevice {
  id           Int      @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  fingerprint  String   // hash UA+IP+screen
  label        String   // "Macbook M3", "iPhone 17"
  lastUsedAt   DateTime @default(now()) @map("last_used_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, fingerprint])
  @@index([adminId])
  @@map("admin_trusted_devices")
}

// ── Tokens API personnels ──────────────────────────────
model AdminApiToken {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  name        String   // "Integration Zapier maison"
  tokenHash   String   @unique @map("token_hash") // SHA-256
  prefix      String   // 8 premiers chars affiches "vnk_pa_xxxxxxxx"
  scopes      Json     // ["read:clients","write:invoices"]
  lastUsedAt  DateTime? @map("last_used_at")
  lastUsedIp  String?  @map("last_used_ip")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([prefix])
  @@map("admin_api_tokens")
}

// ── Security events feed (timeline securite) ───────────
model AdminSecurityEvent {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  type        String   // login_success | login_failed | password_changed | 2fa_enabled | 2fa_disabled | session_revoked | trusted_device_added | api_token_created | api_token_revoked | data_export | suspicious_login | breach_detected | passkey_added | passkey_removed
  severity    String   @default("info") // info | success | warning | critical
  message     String
  metadata    Json?    // contexte additionnel
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  country     String?
  city        String?
  createdAt   DateTime @default(now()) @map("created_at")

  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([type])
  @@index([severity])
  @@map("admin_security_events")
}

// ════════════════════════════════════════════════════════════
// CLIENTS & ÉQUIPES
// ════════════════════════════════════════════════════════════

model Client {
  id             Int       @id @default(autoincrement())
  fullName       String    @map("full_name")
  email          String    @unique
  passwordHash   String    @map("password_hash")
  companyName    String?   @map("company_name")
  phone          String?
  address        String?
  city           String?
  province       String?   @default("QC")
  postalCode     String?   @map("postal_code")
  country        String?   @default("CA")
  sector         String?
  technologies   String?
  internalNotes  String?   @map("internal_notes")
  avatarUrl      String?   @map("avatar_url")
  isActive       Boolean   @default(true) @map("is_active")
  archived       Boolean   @default(false)
  storageQuotaMb Int       @default(1024) @map("storage_quota_mb")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  lastLogin      DateTime? @map("last_login")
  lastSeenAt     DateTime? @map("last_seen_at")

  // Identite etendue
  position           String?
  birthdate          DateTime? @db.Date
  locale             String?   @default("fr-CA")
  timezone           String?   @default("America/Montreal")
  mobilePhone        String?   @map("mobile_phone")
  workPhone          String?   @map("work_phone")
  billingAddress     Json?     @map("billing_address")
  shippingAddress    Json?     @map("shipping_address")

  // Business
  taxNumberTps       String?   @map("tax_number_tps")
  taxNumberTvq       String?   @map("tax_number_tvq")
  taxExempt          Boolean   @default(false) @map("tax_exempt")
  industry           String?
  businessSize       String?   @map("business_size")
  employeeCount      Int?      @map("employee_count")
  annualRevenue      String?   @map("annual_revenue")

  // ─── Conformité fiscale internationale ──────────────────
  // Type d'identifiant fiscal : NEQ (QC), GST_HST (Canada), VAT_EU, VAT_GB, EIN (US), SIRET (FR), RCCM (Afrique), other
  taxIdType          String?   @map("tax_id_type")
  // Valeur du numéro fiscal (ex: FR12345678901, GB123456789, etc.)
  taxIdValue         String?   @map("tax_id_value")
  // Type de client pour règles fiscales (B2B = reverse charge UE, B2C = TVA destination)
  customerType       String?   @default("B2B") @map("customer_type") // 'B2B' | 'B2C'
  // Devise préférée pour facturation (ISO 4217)
  preferredCurrency  String?   @default("CAD") @map("preferred_currency")
  // Validation VIES (UE) — date de dernière vérification du numéro VAT
  viesValidatedAt    DateTime? @map("vies_validated_at")
  // Province/État pour règles fiscales sub-nationales (US sales tax, Canada GST/HST)
  taxRegion          String?   @map("tax_region") // ex: "QC", "ON", "CA-AB", "US-NY"

  // Acquisition
  leadSource         String?   @map("lead_source")
  referrerClientId   Int?      @map("referrer_client_id")

  // Finance
  creditTerms        String?   @default("net_30") @map("credit_terms")
  discountTier       String?   @map("discount_tier")
  currencyPreference String?   @default("CAD") @map("currency_preference")
  preferredPaymentMethod String? @map("preferred_payment_method")
  totalSpentTtc      Decimal   @default(0) @map("total_spent_ttc") @db.Decimal(12, 2)
  openBalanceTtc     Decimal   @default(0) @map("open_balance_ttc") @db.Decimal(12, 2)

  // Compliance / RGPD / Loi 25
  termsAcceptedVersion  String?   @map("terms_accepted_version")
  termsAcceptedAt       DateTime? @map("terms_accepted_at")
  termsAcceptedIp       String?   @map("terms_accepted_ip")
  privacyAcceptedAt     DateTime? @map("privacy_accepted_at")
  marketingConsent      Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt    DateTime? @map("marketing_consent_at")
  dataRetentionPolicy   String?   @default("standard") @map("data_retention_policy")

  // Verification
  identityVerifiedAt    DateTime? @map("identity_verified_at")
  identityVerifiedBy    String?   @map("identity_verified_by")

  // Conversation meta (admin perspective)
  chatPinned     Boolean   @default(false) @map("chat_pinned")
  chatArchivedAt DateTime? @map("chat_archived_at")
  chatSnoozedUntil DateTime? @map("chat_snoozed_until")
  chatLabels     Json?     @map("chat_labels")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  mandates       Mandate[]
  quotes         Quote[]
  invoices       Invoice[]
  contracts      Contract[]
  payments       Payment[]
  refunds        Refund[]
  disputes       Dispute[]
  documents      Document[]
  messages       Message[]
  workflowEvents WorkflowEvent[]
  wsConnections  WsConnection[]
  pageViews      PageView[]
  appointments   Appointment[]
  teamMembers    ClientTeamMember[]
  subscriptions  Subscription[]

  @@index([email])
  @@map("clients")
}

// Nouvelle : plusieurs users par compte client
model ClientTeamMember {
  id           Int      @id @default(autoincrement())
  clientId     Int      @map("client_id")
  email        String
  fullName     String   @map("full_name")
  passwordHash String?  @map("password_hash")
  role         String   @default("viewer") // owner | editor | viewer
  invitedAt    DateTime @default(now()) @map("invited_at")
  acceptedAt   DateTime? @map("accepted_at")
  lastLogin    DateTime? @map("last_login")

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId])
  @@map("client_team_members")
}

// ════════════════════════════════════════════════════════════
// MANDATS, DEVIS, CONTRATS, FACTURES
// ════════════════════════════════════════════════════════════

model Mandate {
  id          Int          @id @default(autoincrement())
  clientId    Int          @map("client_id")
  title       String
  description String?
  serviceType String?      @default("plc-support") @map("service_type")
  status      String        @default("pending")
  progress    Int          @default(0)
  startDate   DateTime?    @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  notes       String?
  estimatedHours  Decimal? @map("estimated_hours") @db.Decimal(6, 2)
  actualHours     Decimal? @map("actual_hours") @db.Decimal(6, 2)
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(8, 2)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotes      Quote[]
  invoices    Invoice[]
  documents   Document[]
  logs        MandateLog[]
  contracts   Contract[]
  disputes    Dispute[]
  workflowEvents WorkflowEvent[]
  timeEntries TimeEntry[]

  @@index([clientId])
  @@index([status])
  @@map("mandates")
}

// Nouvelle : journal horaire facturable par mandat
model TimeEntry {
  id         Int      @id @default(autoincrement())
  mandateId  Int      @map("mandate_id")
  adminId    Int?     @map("admin_id")
  description String
  startedAt  DateTime @map("started_at")
  endedAt    DateTime? @map("ended_at")
  durationMin Int?    @map("duration_min")
  billable   Boolean  @default(true)
  hourlyRate Decimal? @map("hourly_rate") @db.Decimal(8, 2)
  invoiceId  Int?     @map("invoice_id")
  createdAt  DateTime @default(now()) @map("created_at")

  mandate    Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([mandateId])
  @@map("time_entries")
}

model Quote {
  id                    Int         @id @default(autoincrement())
  clientId              Int         @map("client_id")
  mandateId             Int?        @map("mandate_id")
  quoteNumber           String      @unique @map("quote_number")
  title                 String
  description           String?
  serviceType           String?     @map("service_type")
  amountHt              Decimal     @default(0) @map("amount_ht") @db.Decimal(10, 2)
  tpsAmount             Decimal     @default(0) @map("tps_amount") @db.Decimal(10, 2)
  tvqAmount             Decimal     @default(0) @map("tvq_amount") @db.Decimal(10, 2)
  amountTtc             Decimal     @default(0) @map("amount_ttc") @db.Decimal(10, 2)
  currency              String      @default("CAD")
  status                String      @default("pending")
  expiryDate            DateTime?   @map("expiry_date") @db.Date
  acceptedAt            DateTime?   @map("accepted_at")
  declinedAt            DateTime?   @map("declined_at")
  signedAt              DateTime?   @map("signed_at")
  paymentPlan           String?     @default("split_50_50") @map("payment_plan")
  paymentPct1           Int?        @default(50) @map("payment_pct1")
  paymentPct2           Int?        @default(50) @map("payment_pct2")
  paymentConditions     String?     @map("payment_conditions")
  clientSignatureData   String?     @map("client_signature_data")
  discountCode          String?     @map("discount_code")
  discountAmount        Decimal?    @default(0) @map("discount_amount") @db.Decimal(10, 2)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at")

  client                Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mandate               Mandate?    @relation(fields: [mandateId], references: [id])
  contracts             Contract[]
  invoices              Invoice[]
  workflowEvents        WorkflowEvent[]

  @@index([clientId])
  @@index([status])
  @@map("quotes")
}

model Contract {
  id                   Int            @id @default(autoincrement())
  clientId             Int            @map("client_id")
  mandateId            Int?           @map("mandate_id")
  quoteId              Int?           @map("quote_id")
  contractNumber       String         @unique @map("contract_number")
  title                String
  content              String?
  fileUrl              String?        @map("file_url")
  status               String         @default("pending")
  amountTtc            Decimal?       @default(0) @map("amount_ttc") @db.Decimal(10, 2)
  hellosignRequestId   String?        @map("hellosign_request_id")
  signedAt             DateTime?      @map("signed_at")
  clientSignatureData  String?        @map("client_signature_data")
  clientSignatureIp    String?        @map("client_signature_ip")
  adminSignatureData   String?        @map("admin_signature_data")
  adminSignedAt        DateTime?      @map("admin_signed_at")
  expiresAt            DateTime?      @map("expires_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at")

  client               Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mandate              Mandate?       @relation(fields: [mandateId], references: [id])
  quote                Quote?         @relation(fields: [quoteId], references: [id])
  invoices             Invoice[]
  workflowEvents       WorkflowEvent[]

  @@index([clientId])
  @@index([status])
  @@index([quoteId])
  @@map("contracts")
}

model Invoice {
  id                       Int           @id @default(autoincrement())
  clientId                 Int           @map("client_id")
  mandateId                Int?          @map("mandate_id")
  quoteId                  Int?          @map("quote_id")
  contractId               Int?          @map("contract_id")
  invoiceNumber            String        @unique @map("invoice_number")
  title                    String
  description              String?
  serviceType              String?       @map("service_type")
  amountHt                 Decimal       @default(0) @map("amount_ht") @db.Decimal(10, 2)
  tpsAmount                Decimal       @default(0) @map("tps_amount") @db.Decimal(10, 2)
  tvqAmount                Decimal       @default(0) @map("tvq_amount") @db.Decimal(10, 2)
  amountTtc                Decimal       @default(0) @map("amount_ttc") @db.Decimal(10, 2)
  currency                 String        @default("CAD")
  status                   String        @default("unpaid")
  dueDate                  DateTime?     @map("due_date") @db.Date
  paidAt                   DateTime?     @map("paid_at")
  paymentMethod            String?       @map("payment_method")
  invoicePhase             String?       @map("invoice_phase")
  phaseNumber              Int?          @default(1) @map("phase_number")
  stripePaymentIntentId    String?       @map("stripe_payment_intent_id")
  stripeSessionId          String?       @map("stripe_session_id")
  remindersSent            Int           @default(0) @map("reminders_sent")
  lastReminderAt           DateTime?     @map("last_reminder_at")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at")

  client                   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mandate                  Mandate?      @relation(fields: [mandateId], references: [id])
  quote                    Quote?        @relation(fields: [quoteId], references: [id])
  contract                 Contract?     @relation(fields: [contractId], references: [id])
  payments                 Payment[]
  refunds                  Refund[]
  disputes                 Dispute[]
  workflowEvents           WorkflowEvent[]
  timeEntries              TimeEntry[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id                       Int       @id @default(autoincrement())
  invoiceId                Int?      @map("invoice_id")
  clientId                 Int?      @map("client_id")
  stripePaymentIntentId    String?   @map("stripe_payment_intent_id")
  stripeChargeId           String?   @map("stripe_charge_id")
  amount                   Decimal   @db.Decimal(12, 2)
  currency                 String    @default("cad")
  // ─── Multi-devises (figés au paiement pour audit IFRS / ARC) ───
  amountCad                Decimal?  @map("amount_cad") @db.Decimal(12, 2)
  fxRate                   Decimal?  @map("fx_rate") @db.Decimal(12, 6)
  fxRateSource             String?   @map("fx_rate_source") // 'BOC' | 'ECB' | 'manual'
  fxRateDate               DateTime? @map("fx_rate_date") @db.Date
  status                   String    @default("pending")
  paymentMethod            String?   @map("payment_method")
  paidAt                   DateTime? @map("paid_at")
  createdAt                DateTime  @default(now()) @map("created_at")

  // ─── Type Wix-like (transaction type, pour rapport de règlement) ───
  // 'charge' | 'refund' | 'chargeback' | 'chargeback_fee' | 'adjustment' | 'topup' | 'payout'
  type                     String?   @default("charge")

  // ─── 3 dates distinctes (CSV style Wix / Stripe) ───
  // paidAt = Date de paiement (déjà ci-dessus)
  settledAt                DateTime? @map("settled_at")   // Date de règlement (fonds disponibles dans solde Stripe)
  payoutAt                 DateTime? @map("payout_at")    // Date de versement (déposé en banque)

  // ─── Frais Stripe ───────────────────────────────────────────
  processingFee            Decimal?  @map("processing_fee") @db.Decimal(10, 2)
  netAmount                Decimal?  @map("net_amount") @db.Decimal(10, 2)

  // ─── Chaînage Stripe (IDs externes) ─────────────────────────
  stripeBalanceTxId        String?   @map("stripe_balance_tx_id")
  stripePayoutId           String?   @map("stripe_payout_id")
  stripeReceiptUrl         String?   @map("stripe_receipt_url")
  stripeReceiptNumber      String?   @map("stripe_receipt_number")
  stripeReceiptEmail       String?   @map("stripe_receipt_email")

  // ─── Identité carte (utile reçus + sécurité) ───────────────
  cardBrand                String?   @map("card_brand")
  cardLast4                String?   @map("card_last4")
  cardCountry              String?   @map("card_country")     // pays émetteur (issuer)
  cardholderName           String?   @map("cardholder_name")

  // ─── Workflow comptable ──────────────────────────────
  // Catégorie comptable libre : services_recurrent, services_unique, acompte, solde, autre
  accountingCategory       String?   @map("accounting_category")
  // Réconciliation (rapprochement bancaire)
  reconciledAt             DateTime? @map("reconciled_at")
  reconciledBy             String?   @map("reconciled_by") // email admin
  // Export comptable (vers Sage / QuickBooks / Acomba)
  exportedAt               DateTime? @map("exported_at")
  exportedBy               String?   @map("exported_by") // email admin
  exportFormat             String?   @map("export_format") // quickbooks | sage | acomba | csv
  // Affectation à un comptable
  assignedAccountantId     Int?      @map("assigned_accountant_id")
  // Notes internes du comptable
  accountantNotes          String?   @map("accountant_notes")
  // Période fiscale figée à la réconciliation (YYYY-MM) — pour figer les rapports
  fiscalPeriod             String?   @map("fiscal_period")

  invoice                  Invoice?  @relation(fields: [invoiceId], references: [id])
  client                   Client?   @relation(fields: [clientId], references: [id])
  assignedAccountant       Admin?    @relation("AssignedPayments", fields: [assignedAccountantId], references: [id])

  payout                   Payout?   @relation(fields: [stripePayoutId], references: [stripePayoutId])

  @@index([invoiceId])
  @@index([clientId])
  @@index([reconciledAt])
  @@index([fiscalPeriod])
  @@index([assignedAccountantId])
  @@index([stripePayoutId])
  @@index([type])
  @@index([settledAt])
  @@index([payoutAt])
  @@map("payments")
}

// ─── Versements bancaires Stripe (groupe plusieurs Payments) ───────
model Payout {
  id                Int       @id @default(autoincrement())
  stripePayoutId    String    @unique @map("stripe_payout_id")
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("CAD")
  status            String    @default("pending") // pending | in_transit | paid | failed | canceled
  arrivalDate       DateTime? @map("arrival_date") @db.Date
  initiatedAt       DateTime  @default(now()) @map("initiated_at")
  paidAt            DateTime? @map("paid_at")
  failureReason     String?   @map("failure_reason")
  method            String?   // standard | instant
  destinationLast4  String?   @map("destination_last4")
  destinationBank   String?   @map("destination_bank")
  itemCount         Int       @default(0) @map("item_count")
  feeTotal          Decimal   @default(0) @map("fee_total") @db.Decimal(10, 2)
  description       String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  payments          Payment[]

  @@index([status])
  @@index([arrivalDate])
  @@map("payouts")
}

model Refund {
  id              Int      @id @default(autoincrement())
  clientId        Int      @map("client_id")
  invoiceId       Int?     @map("invoice_id")
  stripeRefundId  String?  @map("stripe_refund_id")
  refundNumber    String   @unique @map("refund_number")
  reason          String
  amount          Decimal  @db.Decimal(10, 2)
  tpsAmount       Decimal  @default(0) @map("tps_amount") @db.Decimal(10, 2)
  tvqAmount       Decimal  @default(0) @map("tvq_amount") @db.Decimal(10, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)
  status          String   @default("pending")
  notes           String?
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  client          Client   @relation(fields: [clientId], references: [id])
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([clientId])
  @@map("refunds")
}

model Dispute {
  id               Int             @id @default(autoincrement())
  clientId         Int             @map("client_id")
  invoiceId        Int?            @map("invoice_id")
  mandateId        Int?            @map("mandate_id")
  stripeDisputeId  String?         @map("stripe_dispute_id")
  title            String
  description      String?
  status           String          @default("open")
  priority         String          @default("medium")
  resolution       String?
  openedAt         DateTime        @default(now()) @map("opened_at")
  resolvedAt       DateTime?       @map("resolved_at")

  // Type & catégorisation
  type             String          @default("other") // chargeback | invoice | service | refund | warranty | legal | other
  category         String?         // sous-catégorie libre
  amountDisputed   Decimal?        @map("amount_disputed") @db.Decimal(10, 2)
  currency         String?         @default("CAD")

  // Stripe chargeback specifics
  stripeReason     String?         @map("stripe_reason") // duplicate | fraudulent | subscription_canceled | etc.
  evidenceDueBy    DateTime?       @map("evidence_due_by")
  evidenceSubmittedAt DateTime?    @map("evidence_submitted_at")
  outcome          String?         // won | lost | warning_under_review | warning_closed
  cardBrand        String?         @map("card_brand")

  // Gestion interne
  assignedTo       String?         @map("assigned_to")
  estimatedResolutionDate DateTime? @map("estimated_resolution_date") @db.Date
  escalatedAt      DateTime?       @map("escalated_at")
  internalNotes    String?         @map("internal_notes")
  evidenceDocumentIds Json?        @map("evidence_document_ids") // [docId, ...]

  // Communication
  lastClientContactAt DateTime?    @map("last_client_contact_at")
  nextActionDue    DateTime?       @map("next_action_due")
  contactMethod    String?         @map("contact_method") // email | phone | letter | meeting

  // Escalade juridique
  lawFirmInvolved  String?         @map("law_firm_involved")
  caseNumber       String?         @map("case_number")
  tribunal         String?         // regie_logement | cour_petites_creances | etc.
  smallClaimsFiledAt DateTime?     @map("small_claims_filed_at")

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  client           Client          @relation(fields: [clientId], references: [id])
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id])
  mandate          Mandate?        @relation(fields: [mandateId], references: [id])

  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([assignedTo])
  @@map("disputes")
}

model Expense {
  id           Int      @id @default(autoincrement())
  title        String
  category     String   @default("autre")
  amount       Decimal  @db.Decimal(10, 2)
  tpsPaid      Decimal  @default(0) @map("tps_paid") @db.Decimal(10, 2)
  tvqPaid      Decimal  @default(0) @map("tvq_paid") @db.Decimal(10, 2)
  vendor       String?
  receiptUrl   String?  @map("receipt_url")
  expenseDate  DateTime @map("expense_date") @db.Date
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expenseDate])
  @@map("expenses")
}

model TaxDeclaration {
  id             Int      @id @default(autoincrement())
  periodType     String   @map("period_type")
  periodLabel    String   @map("period_label")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  totalRevenueHt Decimal  @default(0) @map("total_revenue_ht") @db.Decimal(10, 2)
  totalTps       Decimal  @default(0) @map("total_tps") @db.Decimal(10, 2)
  totalTvq       Decimal  @default(0) @map("total_tvq") @db.Decimal(10, 2)
  totalTaxes     Decimal  @default(0) @map("total_taxes") @db.Decimal(10, 2)
  status         String   @default("draft")
  notes          String?
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("tax_declarations")
}

// ════════════════════════════════════════════════════════════
// DOCUMENTS, MESSAGES, ACTIVITÉ
// ════════════════════════════════════════════════════════════

model Document {
  id          Int       @id @default(autoincrement())
  clientId    Int       @map("client_id")
  mandateId   Int?      @map("mandate_id")
  title       String
  description String?
  fileType    String?   @default("pdf") @map("file_type")
  fileName    String?   @map("file_name")
  fileUrl     String?   @map("file_url")
  fileSize    Int?      @map("file_size")
  uploadedBy  String?   @map("uploaded_by")
  category    String?
  status      String?   @default("disponible")
  isRead      Boolean   @default(false) @map("is_read")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mandate     Mandate?  @relation(fields: [mandateId], references: [id])

  @@index([clientId])
  @@map("documents")
}

model Message {
  id              Int       @id @default(autoincrement())
  clientId        Int       @map("client_id")
  sender          String    // 'client' | 'vnk'
  content         String?
  attachmentData  Json?     @map("attachment_data") // legacy single attachment (lecture seule)
  attachmentsData Json?     @map("attachments_data") // array MessageAttachment (preferred)
  reactions       Json?     // { "👍": ["vnk", "client"], "❤️": ["vnk"] }
  replyToId       Int?      @map("reply_to_id")
  isInternalNote  Boolean   @default(false) @map("is_internal_note")
  editedAt        DateTime? @map("edited_at")
  deletedAt       DateTime? @map("deleted_at")
  scheduledFor    DateTime? @map("scheduled_for")
  isRead          Boolean   @default(false) @map("is_read")
  channel         String    @default("chat")
  requestStatus   String?   @map("request_status") // null | new | in_progress | converted | closed
  emailMessageId  String?   @unique @map("email_message_id")
  emailOpenedAt   DateTime? @map("email_opened_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  replyTo         Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[] @relation("MessageReplies")

  @@index([clientId])
  @@index([clientId, isRead])
  @@index([clientId, deletedAt])
  @@map("messages")
}

model MessageTemplate {
  id              Int      @id @default(autoincrement())
  shortcut        String   @unique
  title           String
  body            String
  category        String?
  categoryCustom  String?  @map("category_custom") // sous-categorie libre quand category="other"
  defaultChannel  String?  @map("default_channel") // chat | email | both
  emailSubject    String?  @map("email_subject")
  appendSignature Boolean  @default(false) @map("append_signature")
  defaultAttachmentsData Json? @map("default_attachments_data") // [{name, mimeType, size, dataUrl, kind}]
  tags            Json?    // ["onboarding", "billing"]
  locale          String   @default("fr")
  isSystem        Boolean  @default(false) @map("is_system")
  isActive        Boolean  @default(true) @map("is_active")
  usageCount      Int      @default(0) @map("usage_count")
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  versions        MessageTemplateVersion[]

  @@index([category])
  @@index([locale])
  @@map("message_templates")
}

model MessageTemplateVersion {
  id          Int      @id @default(autoincrement())
  templateId  Int      @map("template_id")
  body        String
  emailSubject String? @map("email_subject")
  editedBy    String?  @map("edited_by") // admin email
  createdAt   DateTime @default(now()) @map("created_at")

  template    MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("message_template_versions")
}

model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  company    String?
  phone      String?
  service    String?
  plcBrand   String?  @map("plc_brand")
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model MandateLog {
  id          Int      @id @default(autoincrement())
  mandateId   Int      @map("mandate_id")
  action      String
  description String?
  createdBy   String   @default("admin") @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  mandate     Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@map("mandate_logs")
}

model WorkflowEvent {
  id           Int      @id @default(autoincrement())
  clientId     Int      @map("client_id")
  mandateId    Int?     @map("mandate_id")
  quoteId      Int?     @map("quote_id")
  contractId   Int?     @map("contract_id")
  invoiceId    Int?     @map("invoice_id")
  eventType    String   @map("event_type")
  eventLabel   String?  @map("event_label")
  triggeredBy  String   @default("admin") @map("triggered_by")
  wsBroadcast  Boolean  @default(false) @map("ws_broadcast")
  metadata     Json?
