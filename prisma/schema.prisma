  value        Decimal? @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  admin        Admin    @relation("AssignedEquipment", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([category])
  @@map("assigned_equipment")
}

